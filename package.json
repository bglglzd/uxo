{
  "name": "uxo-desktop",
  "private": true,
  "version": "0.1.2",
  "description": "Fast, private, local speech-to-text for Windows.",
  "license": "MIT",
  "author": "UXO contributors",
  "homepage": "https://github.com/bglglzd/uxo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bglglzd/uxo.git"
  },
  "bugs": {
    "url": "https://github.com/bglglzd/uxo/issues"
  },
  "packageManager": "bun@1.3.13",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "format:check": "prettier --check . && cd src-tauri && cargo fmt -- --check",
    "format:frontend": "prettier --write .",
    "format:backend": "cd src-tauri && cargo fmt",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "check:translations": "bun scripts/check-translations.ts",
    "postinstall": "bun scripts/check-nix-deps.ts",
    "check:nix-deps": "bun scripts/check-nix-deps.ts --check"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.3",
    "@tauri-apps/plugin-dialog": "~2.6.0",
    "@tauri-apps/plugin-fs": "~2.4.5",
    "@tauri-apps/plugin-global-shortcut": "~2.3.2",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-sql": "~2.3.2",
    "@tauri-apps/plugin-store": "~2.4.5",
    "i18next": "^25.10.10",
    "immer": "^11.2.10",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.6.6",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tauri-plugin-macos-permissions-api": "2.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-select": "^5.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.14.0",
    "eslint-plugin-i18next": "^6.1.5",
    "prettier": "^3.9.10",
    "typescript": "~5.6.3",
    "vite": "^6.4.6"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
